# Shared Konsole profile — deployed to ~/.local/share/konsole/Vulnbox.profile
# (opt-in). Referenced as DefaultProfile by the shipped konsolerc.
[Appearance]
ColorScheme=Breeze
Font=Monospace,11,-1,5,50,0,0,0,0,0

[General]
Name=Vulnbox
Parent=
TerminalColumns=110
TerminalRows=32

[Scrolling]
HistoryMode=2
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=true
